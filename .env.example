# LLM API configuration for dataset generation (--llm-backend env)
# Copy this to .env and fill in your values

# API base URL (e.g., http://localhost:4002/v1 for llama.cpp)
LLM_API_BASE=http://localhost:4002/v1

# API key (set to "not-needed" if no auth required)
LLM_API_KEY=not-needed

# Model name
LLM_MODEL=gemma

# Default temperature
LLM_TEMPERATURE=0.1

# Turn off chain-of-thought on reasoning models (~2x faster judge calls).
# 1 = chat_template_kwargs.enable_thinking=false (vLLM, llama.cpp server),
# or: reasoning_effort, both, chat_template, off
LLM_DISABLE_REASONING=1

# Extra JSON merged into every request (endpoint-specific tuning).
# Wins over LLM_DISABLE_REASONING on conflicting keys.
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Source budgets for the judge. A document that fits inside CHECKER_MAX_DOCS_CHARS
# is passed whole; CHECKER_MAX_CHARS_PER_DOC only applies when the corpus overflows
# the total, so one huge source cannot starve the others.
CHECKER_MAX_DOCS_CHARS=100000
CHECKER_MAX_CHARS_PER_DOC=10000

