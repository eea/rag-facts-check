# LLM API configuration for dataset generation (--llm-backend env)
# Copy this to .env and fill in your values

# API base URL (e.g., http://localhost:4002/v1 for llama.cpp)
LLM_API_BASE=http://localhost:4002/v1

# API key (set to "not-needed" if no auth required)
LLM_API_KEY=not-needed

# Model name
LLM_MODEL=gemma

# Default temperature
LLM_TEMPERATURE=0.1
